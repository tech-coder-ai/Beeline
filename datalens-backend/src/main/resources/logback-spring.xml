<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Must be set before Spring Boot logging includes so PatternLayout gets valid % specifiers. -->
  <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss} | %-7level | %logger{36} | %m%n"/>
  <property name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss} | %-7level | %logger{36} | %m%n"/>

  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <logger name="com.datalens" level="INFO"/>
  <logger name="org.hibernate.SQL" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
